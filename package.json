{
  "name": "izenda-custom-visualizations",
  "version": "1.0.0",
  "description": "The examples of how to customize or extend Izenda visualizations",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack/webpack.config.prod.js --color",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack serve --config webpack/webpack.config.dev.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Izenda7Series/IzendaCustomVisualizations.git"
  },
  "keywords": [
    "webpack",
    "startkit",
    "frontend",
    "es6",
    "javascript",
    "webdev"
  ],
  "author": "Izenda",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Izenda7Series/IzendaCustomVisualizations/issues"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "semi": 2
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "useBuiltIns": "usage",
          "corejs": 3
        }
      ]
    ]
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
  ],
  "homepage": "https://github.com/Izenda7Series/IzendaCustomVisualizations#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "cross-env": "^7.0.3",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-webpack-plugin": "^4.2.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.101.0",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "webpack": "^5.108.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "d3": "^7.9.0",
    "highcharts": "^12.5.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-range": "^2.2.0",
    "moment-timezone": "^0.6.0",
    "regenerator-runtime": "^0.14.1"
  }
}
